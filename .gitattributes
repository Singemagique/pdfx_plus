# Normalize line endings to LF on checkin and checkout on every platform.
# Keeps the Prettier format gate (prettier --check .) stable on Windows too.
* text=auto eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.icns binary
*.ico binary
*.pdf binary
*.pdfx binary

# The vendored Tesseract WebAssembly core is pinned by SHA-256 (build/ocr-core/EXPECTED.sha256 and
# src/main/ocr/process/engine-manifest.ts): never let line-ending normalisation touch its .js glue.
vendor/tesseract-core/** binary
