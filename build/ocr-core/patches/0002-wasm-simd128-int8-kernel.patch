+      const v128_t uu = wasm_v128_load(u + j);
+      const v128_t ulo = wasm_i16x8_extend_low_i8x16(uu);
+      const v128_t uhi = wasm_i16x8_extend_high_i8x16(uu);
+      s0 = DotAdd16(s0, ulo, uhi, w0 + j);
+      s1 = DotAdd16(s1, ulo, uhi, w1 + j);
