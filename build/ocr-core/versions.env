# Pinned inputs of the PDFx Tesseract core (build/ocr-core). build.sh and inner.sh check every value.
#
# PDFX_CORE_REVISION: bump on ANY change here, in patches/ or glue/, or in the build flags, even when
# the Tesseract tag stays the same. It is part of the engine id (tess-lstm/<tag>+pdfx.<rev>/simd,
# src/shared/ocr/engine/tess-core.ts), which saved .pdfx provenance and configHash record, and
# engine-manifest.node.test.ts checks that the two agree.
PDFX_CORE_REVISION=1

# emscripten/emsdk 4.0.15 (the Emscripten tesseract.js-core v7.0.0 pinned), by digest: a
# single-platform linux/amd64 image.
EMSDK_IMAGE=emscripten/emsdk@sha256:27bc6267cb285223b8aebb7627bfebae7cb3ad2aaa0d5923b8aa5321793033e8
EMSDK_VERSION=4.0.15

# Tesseract 5.5.5 (tag 5.5.5 = this commit). GitHub generates /archive/ tarballs on the fly and does
# not promise stable bytes, so the archive SHA-256 is advisory (a mismatch warns) and the content
# pin is TESSERACT_TREE_SHA256, checked inside the container (see inner.sh treehash), together with
# the commit id git embeds in the archive.
TESSERACT_TAG=5.5.5
TESSERACT_COMMIT=4292f6890aa86ef64eba32090358f40f69dd6d28
TESSERACT_URL=https://github.com/tesseract-ocr/tesseract/archive/4292f6890aa86ef64eba32090358f40f69dd6d28.tar.gz
TESSERACT_SHA256=39c4bf5a786227d60177b5d347621ca8ba9939adcfa748346bbcc87239fbb22a
TESSERACT_TREE_SHA256=5fa6131653496ab4df74b362dbd68ed591f2ff16605b7f0b7c694959c944b332

# Leptonica 1.87.0: the maintainer's uploaded release asset (fixed bytes; tag 1.87.0 is commit
# 13275a278eb55b5746e33f95fbf5a2c8f604b3ab).
LEPTONICA_TAG=1.87.0
LEPTONICA_URL=https://github.com/DanBloomberg/leptonica/releases/download/1.87.0/leptonica-1.87.0.tar.gz
LEPTONICA_SHA256=c73363397f96eb1295602bf44d708a994ad42046c791bf03ea0505d829bdb6a7
LEPTONICA_TREE_SHA256=3782f1d19c7d1c2c570c596baf16dbd7fb05e27d5ff436afc39db76cdd261184

# 2026-11-26T17:02:30Z, the Tesseract 5.5.5 release commit. Nothing in the output embeds a date; it
# is set for any tool that might.
SOURCE_DATE_EPOCH=1795712550
