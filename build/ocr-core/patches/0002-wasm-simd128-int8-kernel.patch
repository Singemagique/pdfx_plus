+static inline int32_t HorizontalSum(v128_t s) {
+  s = wasm_i32x4_add(s, wasm_i32x4_shuffle(s, s, 2, 3, 0, 1));
+  s = wasm_i32x4_add(s, wasm_i32x4_shuffle(s, s, 1, 0, 3, 2));
+  return wasm_i32x4_extract_lane(s, 0);
+}
+
+static inline v128_t DotAdd16(v128_t sum, v128_t ulo, v128_t uhi, const int8_t *w) {
+  const v128_t ww = wasm_v128_load(w);
+  sum = wasm_i32x4_add(sum, wasm_i32x4_dot_i16x8(ulo, wasm_i16x8_extend_low_i8x16(ww)));
+  return wasm_i32x4_add(sum, wasm_i32x4_dot_i16x8(uhi, wasm_i16x8_extend_high_i8x16(ww)));
+}
+
+static void matrixDotVector(int dim1, int dim2, const int8_t *wi, const TFloat *scales,
